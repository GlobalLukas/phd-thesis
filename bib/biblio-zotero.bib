	url = {http://arxiv.org/abs/1607.06672},
	doi = {10.48550/arXiv.1607.06672},
	abstract = {In a previous paper we introduced and developed a recursive construction of joint eigenfunctions \$J\_N(a\_+,a\_-,b;x,y)\$ for the Hamiltonians of the hyperbolic relativistic Calogero-Moser system with arbitrary particle number \$N\$. In this paper we focus on the cases \$N=2\$ and \$N=3\$, and establish a number of conjectured features of the corresponding joint eigenfunctions. More specifically, choosing \$a\_+,a\_-\$ positive, we prove that \$J\_2(b;x,y)\$ and \$J\_3(b;x,y)\$ extend to globally meromorphic functions that satisfy various invariance properties as well as a duality relation. We also obtain detailed information on the asymptotic behavior of similarity transformed functions E\$\_2(b;x,y)\$ and E\$\_3(b;x,y)\$. In particular, we determine the dominant asymptotics for \$y\_1-y\_2{\textbackslash}to{\textbackslash}infty\$ and \$y\_1-y\_2,y\_2-y\_3{\textbackslash}to{\textbackslash}infty\$, resp., from which the conjectured factorized scattering can be read off.},
	urldate = {2026-11-09},
	publisher = {arXiv},
	author = {Hallnäs, Martin and Ruijsenaars, Simon},
	month = jan,
	year = {2017},
	note = {arXiv:1607.06672 [math-ph]},
	keywords = {Mathematical Physics, Mathematics - Classical Analysis and ODEs, Mathematics - Quantum Algebra, Nonlinear Sciences - Exactly Solvable and Integrable Systems, Quantum Physics},
	file = {Preprint PDF:/home/lukas/Zotero/storage/RUQ5SMTG/Hallnäs and Ruijsenaars - 2017 - Joint eigenfunctions for the relativistic Calogero-Moser Hamiltonians of hyperbolic type. II. The tw.pdf:application/pdf;Snapshot:/home/lukas/Zotero/storage/IM8U4PCF/1607.html:text/html},
}

