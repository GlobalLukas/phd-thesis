@article{feher_regularization_1997,
	title = {Regularization of {Toda} lattices by {Hamiltonian} reduction},
	volume = {21},
	issn = {03930440},
	url = {http://arxiv.org/abs/hep-th/9511118},
	doi = {10.1016/S0393-0440(96)00010-1},
	abstract = {The Toda lattice defined by the Hamiltonian \$H=\{1{\textbackslash}over 2\} {\textbackslash}sum\_\{i=1\}{\textasciicircum}n p\_i{\textasciicircum}2 + {\textbackslash}sum\_\{i=1\}{\textasciicircum}\{n-1\} ν\_i e{\textasciicircum}\{q\_i-q\_\{i+1\}\}\$ with \$ν\_i{\textbackslash}in {\textbackslash}\{ {\textbackslash}pm 1{\textbackslash}\}\$, which exhibits singular (blowing up) solutions if some of the \$ν\_i=-1\$, can be viewed as the reduced system following from a symmetry reduction of a subsystem of the free particle moving on the group \$G=SL(n,{\textbackslash}Real )\$. The subsystem is \$T{\textasciicircum}*G\_e\$, where \$G\_e=N\_+ A N\_-\$ consists of the determinant one matrices with positive principal minors, and the reduction is based on the maximal nilpotent group \$N\_+ {\textbackslash}times N\_-\$. Using the Bruhat decomposition we show that the full reduced system obtained from \$T{\textasciicircum}*G\$, which is perfectly regular, contains \$2{\textasciicircum}\{n-1\}\$ Toda lattices. More precisely, if \$n\$ is odd the reduced system contains all the possible Toda lattices having different signs for the \$ν\_i\$. If \$n\$ is even, there exist two non-isomorphic reduced systems with different constituent Toda lattices. The Toda lattices occupy non-intersecting open submanifolds in the reduced phase space, wherein they are regularized by being glued together. We find a model of the reduced phase space as a hypersurface in \$\{{\textbackslash}Real\}{\textasciicircum}\{2n-1\}\$. If \$ν\_i=1\$ for all \$i\$, we prove for \$n=2,3,4\$ that the Toda phase space associated with \$T{\textasciicircum}*G\_e\$ is a connected component of this hypersurface. The generalization of the construction for the other simple Lie groups is also presented.},
	number = {2},
