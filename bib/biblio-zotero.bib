	url = {http://arxiv.org/abs/2603.24799},
	doi = {10.48550/arXiv.2603.24799},
	abstract = {We investigate the renormalization group flow and beta functions of Yang-Mills theory and adjoint QCD in a strong, stable, self-dual background field \$F\$. In deep UV, theory runs according to the standard beta function, \$β\_0\$. Treating the background as a superselection sector, we find that the theory abelianizes below the scale \${\textbackslash}sqrt\{F\}\$ and remains strictly abelian in the deep infrared. In the intermediate weakly-coupled regime (\$Λ\_\{{\textbackslash}rm YM\} {\textbackslash}ll μ{\textbackslash}lesssim {\textbackslash}sqrt\{F\}\$), the gauge coupling remarkably continues to run despite the absence of propagating charged degrees of freedom. Because all non-zero Landau levels decouple, this running is driven exclusively by exact zero modes, resulting in an integer-quantized beta function coefficient, \${\textbackslash}widetilde β\_0\$. Finally, we conjecture that this abelian dynamics is governed by an emergent non-commutative effective field theory that is free of pathological UV/IR mixing.},
	urldate = {2026-11-08},
