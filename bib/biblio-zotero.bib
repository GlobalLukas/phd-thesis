@misc{tseytlin_2-loop_2026,
	title = {On 2-loop {AdS}\$\_2\$ superstring partition function in {AdS}\$\_5 {\textbackslash}times {S}{\textasciicircum}5\$ and {AdS}\$\_4{\textbackslash}times {CP}{\textasciicircum}3\$},
	url = {http://arxiv.org/abs/2610.37096},
	doi = {10.48550/arXiv.2610.37096},
	abstract = {We revisit the 2-loop computation of the partition function of the GS superstring expanded near the AdS\$\_2\$ surface in AdS\$\_5{\textbackslash}times S{\textasciicircum}5\$ and AdS\$\_4{\textbackslash}times \{{\textbackslash}rm CP\}{\textasciicircum}3\$, dual to \${\textbackslash}frac\{1\}\{2\}\$ BPS circular Wilson loop in \$\{{\textbackslash}cal N\}=4\$ SYM and ABJM theories. In arXiv:2601.08809 it was done in AdS\$\_5{\textbackslash}times S{\textasciicircum}5\$ using dimensional regularization and a UV pole was found. Since dimensional regularization is problematic for the GS string, here we use a heat-kernel cutoff instead. Then the contribution of the local path integral measure, proportional to \$δ(0)\$, can no longer be ignored. We show that it cancels the \$δ(0)\$ terms coming from the quartic interactions in the action, leaving the square of the difference \$\{{\textbackslash}rm Str\}{\textbackslash},E\$ between the regularized numbers of bosonic and fermionic modes. The result is thus UV finite, the pole of arXiv:2601.08809 being an artefact of dimensional regularization. If all fields are regularized with the same smearing kernel, \$\{{\textbackslash}rm Str\}{\textbackslash},E=0\$ and the 2-loop coefficient \$f\_2\$ vanishes, in tension with \$f\_2={\textbackslash}frac\{3\}\{32π{\textasciicircum}2\}\$ in SYM theory. In the AdS\$\_4{\textbackslash}times\{{\textbackslash}rm CP\}{\textasciicircum}3\$ case the same cancellation leaves a finite term proportional to the square of the coincident value of the massless 2d fermion Green's function, giving, ironically, \$f\_2={\textbackslash}frac\{3\}\{32π{\textasciicircum}2\}\$ instead of \$f\_2=0\$ required by localization. This term is the level-zero (string) part of the result of arXiv:2609.14497 for the AdS\$\_2{\textbackslash}times S{\textasciicircum}1\$ M2 brane in AdS\$\_4{\textbackslash}times S{\textasciicircum}7/{\textbackslash}mathbb Z\_k\$, where it is cancelled by the higher \$S{\textasciicircum}1\$ modes, which also remove a finite mass shift of the massless fermion in conflict with the AdS\$\_2\$ supersymmetry. This suggests that the type II string path integral measure should contain an extra contribution, supplied in the IIA case by the parent M2 brane; in the AdS\$\_5{\textbackslash}times S{\textasciicircum}5\$ case it is still to be identified and may resolve the remaining 2-loop mismatch with localization.},
	urldate = {2026-11-08},
	publisher = {arXiv},
	author = {Tseytlin, Arkady A.},
	month = nov,
	year = {2026},
	note = {arXiv:2610.37096 [hep-th]},
	keywords = {High Energy Physics - Theory},
