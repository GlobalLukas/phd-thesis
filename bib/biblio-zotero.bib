	journal = {Journal of Geometry and Physics},
	author = {Feher, Laszlo and Tsutsui, Izumi},
	month = jan,
	year = {1997},
	note = {arXiv:hep-th/9511118},
	keywords = {High Energy Physics - Theory, Nonlinear Sciences - Exactly Solvable and Integrable Systems},
	pages = {97--135},
	file = {Preprint PDF:/home/lukas/Zotero/storage/9N4GEZXD/Feher and Tsutsui - 1997 - Regularization of Toda lattices by Hamiltonian reduction.pdf:application/pdf;Snapshot:/home/lukas/Zotero/storage/A6QGN5HK/9511118.html:text/html},
