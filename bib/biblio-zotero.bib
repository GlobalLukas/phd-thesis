@article{tsymbaliuk_affine_2017,
	title = {The affine {Yangian} of \${\textbackslash}mathfrak\{gl\}\_1\$ revisited},
	volume = {304},
	issn = {00018708},
	url = {http://arxiv.org/abs/1404.5240},
