	pages = {046503},
	file = {Preprint PDF:/home/lukas/Zotero/storage/UNIS9XSG/Moussa et al. - 2025 - A solvable non-unitary fermionic long-range model with extended symmetry.pdf:application/pdf;Snapshot:/home/lukas/Zotero/storage/5RQYDI2Y/2404.html:text/html},
}

