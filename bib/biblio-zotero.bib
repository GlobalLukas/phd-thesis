	keywords = {High Energy Physics - Theory},
	pages = {001--001},
	file = {Preprint PDF:/home/lukas/Zotero/storage/SV23CXM2/Serban and Staudacher - 2004 - Planar N=4 gauge theory and the Inozemtsev long range spin chain.pdf:application/pdf;Snapshot:/home/lukas/Zotero/storage/GF2AA2RU/0401057.html:text/html},
}

@article{lewis_schur_2026,
