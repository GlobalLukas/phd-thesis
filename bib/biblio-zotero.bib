	author = {Webster, Ben},
	month = aug,
	year = {2026},
	note = {arXiv:1611.06541 [math.RT]},
	keywords = {Mathematics - Representation Theory, Mathematics - Rings and Algebras},
	file = {Preprint PDF:/home/lukas/Zotero/storage/AAVW9G9J/Webster - 2026 - Koszul duality between Higgs and Coulomb categories \$mathcal O \$.pdf:application/pdf;Snapshot:/home/lukas/Zotero/storage/2UCNHAHV/1611.html:text/html},
