@misc{maruyoshi_surface_2026,
	title = {Surface defects on lens space and transfer matrices},
	url = {http://arxiv.org/abs/2610.28165},
	doi = {10.48550/arXiv.2610.28165},
	abstract = {We study surface defects in four-dimensional \${\textbackslash}mathcal\{N\}=2\$ theories of class \${\textbackslash}mathcal\{S\}\$ and \${\textbackslash}mathcal\{N\}=1\$ theories of class \${\textbackslash}mathcal\{S\}\_k\$ placed on \$L(r,1){\textbackslash}times S{\textasciicircum}1\$. The lens space index depends on the fugacities \$p\$ and \$q\$, and the effect of the defects on it is captured by difference operators acting on the fugacities and holonomies of flavor symmetries. For theories of type \$A\_1\$ we determine in closed form the difference operators for the basic defects, labeled by \$p{\textasciicircum}r\$, \$q{\textasciicircum}r\$ and \$pq\$, and show that for odd \$r\$ there exist additional elementary defects, whose operators shift the holonomy by one half modulo \$r\$. All the operators commute, and the elementary operators generate the others. For even \$r\$ the same holds once the holonomy is extended to a twisted sector. We show that the elementary operators are traces of \$L\$-operators whose entries generate a Sklyanin algebra, with nome \$q{\textasciicircum}r\$ and shift \$pq\$. The lens space enters only through the parameters of the algebra and through its representation, which is realized on a doubled holonomy label. The \$p\$- and \$q\$-type algebras form a lens space version of the elliptic modular double. For class \${\textbackslash}mathcal\{S\}\_k\$ theories we propose, and test in several ways, that the defect operators are transfer matrices of inhomogeneous spin chains built from these \$L\$-operators. Throughout, we use the TQFT structure of the lens space index, which follows from S-duality, both to fix and to check the operators.},
