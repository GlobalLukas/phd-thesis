	url = {http://arxiv.org/abs/2309.07596},
	doi = {10.1016/j.physrep.2023.12.003},
	abstract = {This is a review article on the quantum toroidal algebras, focusing on their roles in various solvable structures of 2d conformal field theory, supersymmetric gauge theory, and string theory. Using \${\textbackslash}mathcal\{W\}\$-algebras as our starting point, we elucidate the interconnection of affine Yangians, quantum toroidal algebras, and double affine Hecke algebras. Our exploration delves into the representation theory of the quantum toroidal algebra of \${\textbackslash}mathfrak\{gl\}\_1\$ in full detail, highlighting its connections to partitions, \${\textbackslash}mathcal\{W\}\$-algebras, Macdonald functions, and the notion of intertwiners. Further, we also discuss integrable models constructed on Fock spaces and associated \${\textbackslash}mathcal\{R\}\$-matrices, both for the affine Yangian and the quantum toroidal algebra of \${\textbackslash}mathfrak\{gl\}\_1\$. The article then demonstrates how quantum toroidal algebras serve as a unifying algebraic framework that bridges different areas in physics. Notably, we cover topological string theory and supersymmetric gauge theories with eight supercharges, incorporating the AGT duality. Drawing upon the representation theory of the quantum toroidal algebra of \${\textbackslash}mathfrak\{gl\}\_1\$, we provide a rather detailed review of its role in the algebraic formulations of topological vertex and \$qq\$-characters. Additionally, we briefly touch upon the corner vertex operator algebras and quiver quantum toroidal algebras.},
	urldate = {2026-11-08},
	journal = {Physics Reports},
	author = {Matsuo, Yutaka and Nawata, Satoshi and Noshita, Go and Zhu, Rui-Dong},
	month = mar,
	year = {2024},
	note = {arXiv:2309.07596 [hep-th]},
	keywords = {Mathematics - Representation Theory, Mathematical Physics, Mathematics - Quantum Algebra, High Energy Physics - Theory},
	pages = {1--144},
	file = {Preprint PDF:/home/lukas/Zotero/storage/XRSLTNI3/Matsuo et al. - 2024 - Quantum toroidal algebras and solvable structures in gaugestring theory.pdf:application/pdf;Snapshot:/home/lukas/Zotero/storage/6QKHCGF9/2309.html:text/html},
}

@misc{dimofte_tannakian_2024,
