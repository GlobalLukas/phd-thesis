	keywords = {Mathematical Physics, High Energy Physics - Theory},
	file = {Preprint PDF:/home/lukas/Zotero/storage/5APCUNZH/Razamat and Sabag - 2020 - SQCD and pairs of pants.pdf:application/pdf;Snapshot:/home/lukas/Zotero/storage/WEGBDHZM/2006.html:text/html},
