	keywords = {Mathematics - Representation Theory},
	pages = {1249--1312},
	file = {Preprint PDF:/home/lukas/Zotero/storage/NW8K8BRP/Braverman et al. - 2020 - Cyclotomic double affine Hecke algebras (with an appendix by Hiraku Nakajima and Daisuke Yamakawa).pdf:application/pdf;Snapshot:/home/lukas/Zotero/storage/EP6VZFMW/1611.html:text/html},
