}

@misc{dimofte_line_2025,
	title = {Line {Operators} in 3d {Holomorphic} {QFT}: {Meromorphic} {Tensor} {Categories} and dg-{Shifted} {Yangians}},
	shorttitle = {Line {Operators} in 3d {Holomorphic} {QFT}},
	url = {http://arxiv.org/abs/2508.11749},
	doi = {10.48550/arXiv.2508.11749},
	abstract = {We study line operators and their OPE's in perturbative 3d holomorphic-topological QFT's, including holomorphic-topological twists (quarter-BPS sectors) of 3d \$N=2\$ theories. In particular, we develop the representation theory of the category \$C\$ of perturbative line operators and its chiral tensor product, by generalizing techniques introduced by Costello and collaborators. We argue that lines are equivalent to modules for an \$A\_{\textbackslash}infty\$ algebra \$A{\textasciicircum}!\$ that's Koszul-dual to bulk local operators. We further establish a non-renormalization theorem for the OPE's of lines in a large class of theories (dubbed quasi-linear), allowing an exact resummation of quantum corrections. Based on physics arguments, we propose axioms for the full algebraic structure on \$A{\textasciicircum}!\$, calling it a "dg-shifted Yangian," which controls the OPE of lines. A key part of the structure is a Maurer-Cartan element \$r(z){\textbackslash}in A{\textasciicircum}!{\textbackslash}otimes A{\textasciicircum}!({\textbackslash}!(z{\textasciicircum}\{-1\}){\textbackslash}!)\$ that satisfies an \$A\_{\textbackslash}infty\$ generalization of the Yang-Baxter equation. As examples, we consider 3d \$N=2\$ gauge theories with arbitrary Chern-Simons levels, linear matter, and superpotential, and explicitly compute 1) perturbative bulk local operators (as \$A\_{\textbackslash}infty\$-chiral algebras); and 2) the Koszul-duals \$A{\textasciicircum}!\$ (proving they are dg-shifted Yangians).},
	urldate = {2026-11-08},
	publisher = {arXiv},
	author = {Dimofte, Tudor and Niu, Wenjun and Py, Victor},
	month = aug,
	year = {2025},
	note = {arXiv:2508.11749 [hep-th]},
	keywords = {Mathematics - Representation Theory, Mathematical Physics, Mathematics - Quantum Algebra, High Energy Physics - Theory},
	file = {Preprint PDF:/home/lukas/Zotero/storage/9VFZ7JRL/Dimofte et al. - 2025 - Line Operators in 3d Holomorphic QFT Meromorphic Tensor Categories and dg-Shifted Yangians.pdf:application/pdf;Snapshot:/home/lukas/Zotero/storage/VACQXXUS/2508.html:text/html},
}

