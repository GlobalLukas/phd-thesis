	abstract = {Let \$G\$ be a connected semisimple Lie group. There are two natural duality constructions that assign to it the Langlands dual group \$G{\textasciicircum}{\textbackslash}vee\$ and the Poisson-Lie dual group \$G{\textasciicircum}*\$. The main result of this paper is the following relation between these two objects: the integral cone defined by the cluster structure and the Berenstein-Kazhdan potential on the double Bruhat cell \$G{\textasciicircum}\{{\textbackslash}vee; w\_0, e\} {\textbackslash}subset G{\textasciicircum}{\textbackslash}vee\$ is isomorphic to the integral Bohr-Sommerfeld cone defined by the Poisson structure on the partial tropicalization of \$K{\textasciicircum}* {\textbackslash}subset G{\textasciicircum}*\$ (the Poisson-Lie dual of the compact form \$K {\textbackslash}subset G\$). By [5], the first cone parametrizes the canonical bases of irreducible \$G\$-modules. The corresponding points in the second cone belong to integral symplectic leaves of the partial tropicalization labeled by the highest weight of the representation. As a by-product of our construction, we show that symplectic volumes of generic symplectic leaves in the partial tropicalization of \$K{\textasciicircum}*\$ are equal to symplectic volumes of the corresponding coadjoint orbits in \${\textbackslash}operatorname\{Lie\}(K){\textasciicircum}*\$. To achieve these goals, we make use of (Langlands dual) double cluster varieties defined by Fock and Goncharov [9]. These are pairs of cluster varieties whose seed matrices are transpose to each other. There is a naturally defined isomorphism between their tropicalizations. The isomorphism between the cones described above is a particular instance of such an isomorphism associated to the double Bruhat cells \$G{\textasciicircum}\{w\_0, e\} {\textbackslash}subset G\$ and \$G{\textasciicircum}\{{\textbackslash}vee; w\_0, e\} {\textbackslash}subset G{\textasciicircum}{\textbackslash}vee\$.},
	urldate = {2026-11-08},
	publisher = {arXiv},
	author = {Alekseev, Anton and Berenstein, Arkady and Hoffman, Benjamin and Li, Yanpeng},
	month = may,
	year = {2019},
	note = {arXiv:1806.04104 [math.RT]},
	keywords = {Mathematics - Representation Theory, Mathematics - Symplectic Geometry},
	file = {Preprint PDF:/home/lukas/Zotero/storage/S4MJI9AW/Alekseev et al. - 2019 - Langlands Duality and Poisson-Lie Duality via Cluster Theory and Tropicalization.pdf:application/pdf;Snapshot:/home/lukas/Zotero/storage/L78RPZ2U/1806.html:text/html},
}

